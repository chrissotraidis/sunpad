{
  "schema_version": 1,
  "id": "sunpad",
  "name": "SunPad",
  "game": "Super Mario Sunshine (GameCube, GMSE01 rev 0)",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "gamecube-disc",
      "formats": [
        "iso"
      ],
      "when": "build",
      "description": "Your own GMSE01 USA revision 0 disc image; prepare-game.sh checks its SHA-256 and extracts it privately."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental",
        "linux-x86_64": "experimental",
        "linux-arm64": "experimental"
      },
      "tools": [
        "git",
        "cmake",
        "ninja",
        "libcxx"
      ],
      "published_app": "SunPad-v{version}-ios-unsigned.ipa",
      "output": "ipa",
      "check": "ipa",
      "ios_module": {
        "file": "{repo}/build/ios-module-padmint/gGMSE01_recomp.dylib",
        "into": "gGMSE01_recomp.dylib"
      },
      "steps": [
        {
          "stage": "dependencies",
          "command": [
            "{repo}/scripts/bootstrap-dependencies.sh"
          ]
        },
        {
          "stage": "prepare",
          "command": [
            "{repo}/scripts/prepare-game.sh",
            "{disc}"
          ]
        },
        {
          "stage": "module",
          "command": [
            "{repo}/scripts/build-ios-module.sh",
            "{ios_toolchain}",
            "{repo}/build/ios-module-padmint"
          ],
          "env": {
            "SUNPAD_JOBS": "{jobs}"
          }
        }
      ]
    },
    "macos": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "tools": [
        "git",
        "cmake",
        "ninja"
      ],
      "output": "zip",
      "check": "none",
      "steps": [
        {
          "stage": "dependencies",
          "command": [
            "{repo}/scripts/bootstrap-dependencies.sh"
          ]
        },
        {
          "stage": "prepare",
          "command": [
            "{repo}/scripts/prepare-game.sh",
            "{disc}"
          ]
        },
        {
          "stage": "compile",
          "command": [
            "{repo}/scripts/package-macos-app.sh"
          ]
        },
        {
          "stage": "version",
          "command": [
            "{python}",
            "-c",
            "import json,plistlib,sys\nv=json.load(open(sys.argv[1]))\np=sys.argv[2]+'/Contents/Info.plist'\nwith open(p,'rb') as f: info=plistlib.load(f)\ninfo['CFBundleShortVersionString']=v['version']\ninfo['CFBundleVersion']=str(v['build'])\nwith open(p,'wb') as f: plistlib.dump(info,f)\n",
            "{repo}/version.json",
            "{repo}/build-macos/SunPad.app"
          ]
        },
        {
          "stage": "sign",
          "command": [
            "/usr/bin/codesign",
            "--force",
            "--deep",
            "--sign",
            "-",
            "{repo}/build-macos/SunPad.app"
          ]
        },
        {
          "stage": "package",
          "command": [
            "/usr/bin/ditto",
            "-c",
            "-k",
            "--keepParent",
            "{repo}/build-macos/SunPad.app",
            "{output}"
          ]
        }
      ]
    }
  },
  "requirements": {
    "disk_gb": 30,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "player": true,
        "note": "Install full Xcode and its iOS platform (Command Line Tools alone are not enough). Complete first-launch setup, then select Xcode in Xcode > Settings > Locations > Command Line Tools.",
        "hosts": [
          "macos-arm64"
        ]
      },
      {
        "name": "xcrun",
        "label": "Xcode iOS SDK",
        "version_args": [
          "--sdk",
          "iphoneos",
          "--show-sdk-path"
        ],
        "player": true,
        "note": "Install Xcode's iOS platform and select full Xcode in Xcode > Settings > Locations > Command Line Tools, then run PadMint again.",
        "hosts": [
          "macos-arm64"
        ]
      }
    ]
  },
  "notes": "PadMint builds gGMSE01_recomp.dylib with scripts/build-ios-module.sh in build/ios-module-padmint, checks its imports, and adds it to the published app for personal use.",
  "publication": {
    "public_binaries": false,
    "reason": "The release publishes the app without game code; PadMint adds the module translated from the player's own disc, which stays personal."
  }
}

*~

# Runtime gitlinks are explicitly tracked; all other reference material stays private.
ref/
__pycache__/

# Local iOS provisioning (build products + host paths)
apple/ios/Provisioned/

# Local tvOS provisioning (build products + generated module)
apple/tvos/Provisioned/

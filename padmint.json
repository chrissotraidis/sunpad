{
  "schema_version": 1,
  "id": "sunpad",
  "name": "SunPad",
  "game": "Super Mario Sunshine (GameCube, GMSE01 rev 0)",
  "kind": "disc-translation",
  "status": "experimental",
  "inputs": [
    {
      "type": "gamecube-disc",
      "formats": [
        "iso"
      ],
      "when": "build",
      "description": "Your own GMSE01 USA revision 0 disc image; prepare-game.sh checks its SHA-256 and extracts it privately."
    }
  ],
  "targets": {
    "ios": {
      "hosts": {
        "macos-arm64": "experimental"
      },
      "tools": [
        "git",
        "cmake",
        "ninja"
      ],
      "published_app": "SunPad-v{version}-ios-unsigned.ipa",
      "output": "ipa",
      "check": "none",
      "steps": [
        {
          "stage": "dependencies",
          "command": [
            "{repo}/scripts/bootstrap-dependencies.sh"
          ]
        },
        {
          "stage": "prepare",
          "command": [
            "{repo}/scripts/prepare-game.sh",
            "{disc}"
          ]
        },
        {
          "stage": "translate",
          "command": [
            "{repo}/scripts/ios-build-core-device.sh"
          ]
        },
        {
          "stage": "package",
          "command": [
            "{repo}/scripts/package-ios.sh",
            "{app}",
            "{repo}/build/ios-module-device/gGMSE01_recomp.dylib",
            "{output}"
          ]
        }
      ]
    },
    "macos": {
      "hosts": {
        "macos-arm64": "planned"
      }
    }
  },
  "requirements": {
    "disk_gb": 30,
    "tools": [
      {
        "name": "git",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "cmake",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "ninja",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "python3",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "rg",
        "version_args": [
          "--version"
        ]
      },
      {
        "name": "xcodebuild",
        "version_args": [
          "-version"
        ],
        "note": "Install Xcode and its iOS platform"
      }
    ]
  },
  "notes": "The app loads the translated game from a separate module (gGMSE01_recomp.dylib); package-ios.sh places it with the app. ios-build-core-device.sh builds the module in build/ios-module-device inside the checkout.",
  "publication": {
    "public_binaries": false,
    "reason": "The release publishes the app without game code; PadMint adds the module translated from the player's own disc, which stays personal."
  }
}
